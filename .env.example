# ==============================================================================
# XTTECH Web Application - Mẫu Biến Môi Trường (.env.example)
# Sao chép file này thành .env.local khi chạy local: cp .env.example .env.local
# ==============================================================================

# Backend REST & WebSocket API URL
NEXT_PUBLIC_API_URL=https://dev-xt-api-v2.up.railway.app

# MinIO S3 Object Storage Public URL
NEXT_PUBLIC_MINIO_URL=https://minio-production-2298.up.railway.app

# Public Website Canonical Domain (dùng cho SEO metadataBase, sitemap & OpenGraph)
NEXT_PUBLIC_SITE_URL=https://xttech.vn

# Meta Pixel (Facebook Pixel ID) phục vụ theo dõi chuyển đổi quảng cáo (Tùy chọn)
# Để trống nếu không sử dụng hoặc khi chạy môi trường dev cá nhân
NEXT_PUBLIC_FB_PIXEL_ID=1603545881517618
